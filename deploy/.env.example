# OrionTrade — продовые секреты. Скопировать в deploy/.env и заполнить.
# deploy/.env в .gitignore (правило .env) — реальные значения не коммитим.
#
#   cp .env.example .env
#   # сгенерировать секреты:
#   #   DB_PASSWORD:          openssl rand -hex 24
#   #   DJANGO_SECRET_KEY:    openssl rand -base64 48

# --- Postgres ---
DB_NAME=binary
DB_USER=orion
DB_PASSWORD=

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=oriontrade.tech,www.oriontrade.tech,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://oriontrade.tech,https://www.oriontrade.tech

# --- Cloudflare Tunnel ---
# Токен коннектора из дашборда: Zero Trust -> Networks -> Tunnels ->
# <твой туннель> -> Install connector -> Docker (строка после `--token`).
# Пусто = туннель выключен (apply.sh не поднимает cloudflared).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Образы ---
# IMAGE_TAG выставляет deploy/apply.sh при каждом деплое (sha-<commit>).
# Руками менять не нужно; для локали — IMAGE_TAG=local + docker-compose.build.yml.
IMAGE_TAG=main
# IMAGE_PREFIX=ghcr.io/daniil-svetlov/broker   # переопределить при форке
