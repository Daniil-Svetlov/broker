# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=binary
DB_USER=postgres
DB_PASSWORD=1234

# HTTP API сервиса котировок (Django ходит сюда за живой ценой)
HTTP_ADDR=:8090

# Источник реального базового курса (форекс, обновляется раз в сутки)
RATES_API_URL=https://open.er-api.com/v6/latest/USD

# Периоды фоновых задач
BASE_REFRESH_INTERVAL=5m
TICK_INTERVAL=1s
PERSIST_INTERVAL=10s

# Симуляция: волатильность тика (доля цены) и спред (доля цены)
TICK_VOLATILITY=0.00012
SPREAD=0.0001
